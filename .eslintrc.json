{
    "env": { "browser": true, "es2021": true },
    "parserOptions": { "ecmaVersion": 2021, "sourceType": "script" },
    "rules": {
        "no-undef": "error",
        "no-redeclare": "error",
        "no-dupe-keys": "error",
        "no-dupe-args": "error",
        "no-unreachable": "error",
        "no-const-assign": "error",
        "no-unused-vars": ["warn", { "vars": "local", "args": "none" }]
    }
}
